    "questionText": "What is the anticoagulation reversal protocol for emergency mechanical thrombectomy in OR 4?",
    "askedBy": "Dr. Remy Hadley (Orientee RN)",
    "role": "Circulating RN",
    "createdAt": "2026-10-27T13:45:00Z",
    "answers": [
      {
        "answerId": "pa-pp-2a",
